STATAMIC_CONTAINER=statamic_constructure
STATAMIC_SSL_PORT=8454 ## SSL in local, but actually is the FPM_PORT in remote, no the SSL_PORT, since TLS is handled by host NGINX in remote. We will keep the name ,but it's good to know what actually this is for.
STATAMIC_HOST=constructure.localhost

NODE_CONTAINER=node_constructure
NODE_PORT=5174 # 5173 default


LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

OPCACHE_VALIDATE_TIMESTAMPS = 1 # "1" is a dev-friendly setting. In production it is commonly set more aggressively for performance -> "0".

# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# UID=501
# GID=1000

